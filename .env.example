# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit `.env`. Only this example file belongs in git.
# ------------------------------------------------------------------

# ---------- App ----------
PORT=3000

# ---------- Database (MongoDB) ----------
# Local:  mongodb://<user>:<password>@<host>:<port>/<database>?authSource=admin
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DB_URL="mongodb://<user>:<password>@<host>:<port>/<database>?authSource=admin"
DB_PORT=27017
DB_PASSWORD="your_db_password"

# ---------- Cloudinary (video clips / media uploads) ----------
# Get these from https://console.cloudinary.com -> Dashboard
CLOUD_NAME=your_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET="your_cloudinary_api_secret"

# ---------- Email (SMTP) ----------
# For Gmail, use an App Password, not your account password
EMAIL_USER="your_email@example.com"
EMAIL_PASSWORD="your_email_app_password"

# ---------- JWT ----------
# Use a long random string, e.g.:  openssl rand -base64 64
JWT_SECRET=change_me_to_a_long_random_secret

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379