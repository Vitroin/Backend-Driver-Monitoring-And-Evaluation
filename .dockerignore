coverage
test
**/*.spec.ts
vitest.config.ts
vitest.config.e2e.ts

# Editor / OS files
.vscode
.idea
*.log
.DS_Store
Thumbs.db

# Docker files themselves
Dockerfile
.dockerignore
docker-compose*.yml
