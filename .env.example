# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit `.env`. Only this example file belongs in git.
# Variables with a value here are optional: that value is the default.
# The full list, with validation, is in src/config/validations/config.validation.ts
# ------------------------------------------------------------------

# ---------- App ----------
# development | test | production (production turns off Swagger)
NODE_ENV=development
PORT=3000
# true behind nginx / a load balancer, so rate limits use the real client IP
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The web app: links in emails point here
APP_CLIENT_URL=http://localhost:5173

# ---------- Database (MongoDB) ----------
# Must be a replica set: transactions need one. `docker compose up mongo` starts a single-node one (rs0).
# From your machine to the compose container, add directConnection=true:
#   mongodb://127.0.0.1:27017/Sahi?replicaSet=rs0&directConnection=true
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DB_URL=

# ---------- Redis (cache, OTPs, one-time tokens, mail queue) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Email (Gmail SMTP) ----------
# Use an App Password, not the account password
MAILER_USERNAME=
MAILER_PASSWORD=

# ---------- Tokens ----------
# At least 32 characters each, e.g.:  openssl rand -base64 48
JWT_SECRET=
OTP_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
OTP_EXPIRY_MINUTES=5

# ---------- FastAPI (AI coaching service) ----------
FASTAPI_URL=http://127.0.0.1:8000
FASTAPI_TIMEOUT_MS=5000
# Shared secret sent as X-Service-Token on every call to FastAPI
SERVICE_TOKEN=

# ---------- Cloudinary (incident clips; not used yet, optional) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
